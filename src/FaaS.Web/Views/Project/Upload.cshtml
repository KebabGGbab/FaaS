@model FunctionUploadDto

@section head{
    <th:link href="~/styles/Project.css" rel="stylesheet" />
}

<section class="container">
    <th:form action="Upload" method="post" enctype="multipart/form-data">
        <h1 class="top-header">Загрузить функцию</h1>

        <th:div asp-validation-summary="ModelOnly" class="form-property-validation-summary text-error"></th:div>

        <div class="form-groups">
            <th:label asp-for="Name" class="property-label required"></th:label>
            <th:input asp-for="Name" class="form-property" />
            <th:span asp-validation-for="Name" class="form-property-validation text-error"></th:span>

            <th:label asp-for="Description" class="property-label"></th:label>
            <th:input asp-for="Description" class="form-property" />
            <th:span asp-validation-for="Description" class="form-property-validation text-error"></th:span>

            <th:label asp-for="Language" class="property-label required"></th:label>
            <th:select asp-for="Language" asp-items="@Html.GetEnumSelectList<LanguagesDto>()" class="form-property"></th:select>
            <th:span asp-validation-for="Language" class="form-property-validation text-error"></th:span>

            <th:label asp-for="File" class="property-label required"></th:label>
            <th:input asp-for="File" class="form-property" />
            <th:span asp-validation-for="File" class="form-property-validation text-error"></th:span>
        </div>
    
        <div class="container-submit-form">
            <button type="submit" class="button-submit-form">Загрузить</button>
        </div>       

    </th:form>
</section>